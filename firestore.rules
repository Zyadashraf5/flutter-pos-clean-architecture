rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: read if authenticated; write only own document
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // Orders: read/write if authenticated
    match /orders/{orderId} {
      allow read, write: if request.auth != null;
    }

    // Optional: restrict other collections to authenticated users
    match /categories/{docId} {
      allow read, write: if request.auth != null;
    }
    match /products/{docId} {
      allow read, write: if request.auth != null;
    }
    match /financial_summary/{docId} {
      allow read, write: if request.auth != null;
    }
    match /system_settings/{docId} {
      allow read, write: if request.auth != null;
    }
    match /suppliers/{docId} {
      allow read, write: if request.auth != null;
    }
    match /purchases/{docId} {
      allow read, write: if request.auth != null;
    }
  }
}
